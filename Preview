        badEl.textContent = pair[0];
        goodEl.textContent = pair[1];
        setTimeout(function () { thesis.classList.add('flag'); }, 1050);          /* detector flags it */
        setTimeout(function () { thesis.classList.add('fixed'); }, 1900);         /* strike + correction */
        setTimeout(function () { idx = (idx + 1) % PAIRS.length; cycle(); }, 5400);
      }
      cycle();
    }
  })();
  </script>
</body>
